load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "mocks",
    hdrs = ["Mocks.h"],
    include_prefix = "wangle/bootstrap/test",
    deps = [
        "//:wangle",
        "@folly//folly/portability:gmock",
        "@folly//folly/portability:gtest",
    ],
)

cc_test(
    name = "AcceptRoutingHandlerTest",
    srcs = ["AcceptRoutingHandlerTest.cpp"],
    deps = [
        ":mocks",
        "//:wangle",
        "//wangler/test:test_main",
        "@folly//folly/synchronization:latch",
        "@googletest//:gmock",
    ],
)

cc_test(
    name = "BootstrapTest",
    srcs = ["BootstrapTest.cpp"],
    deps = [
        ":mocks",
        "//:wangle",
        "//wangler/test:test_main",
        "@folly//folly/test:test_utils",
        "@googletest//:gmock",
    ],
)
